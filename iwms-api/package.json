  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^11.0.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "docxtemplater": "^3.68.7",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "pizzip": "^3.2.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "pg": "^8.21.0"
  }
}
