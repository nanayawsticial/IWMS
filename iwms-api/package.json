{
  "name": "iwms-api",
  "version": "1.0.0",
  "description": "IWMS Backend API — Node.js + Fastify + Prisma + PostgreSQL (Supabase)",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:reset": "npx prisma migrate reset --force && node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "start": "node server.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
